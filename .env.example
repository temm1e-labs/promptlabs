# Copy to .env and fill in the providers you actually use.
# LiteLLM picks these up automatically. You only need keys for providers
# you plan to use as either agent models or target models.

# ─── Provider API keys ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Optional: AWS Bedrock / Azure / Vertex
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

# ─── PromptLabs config ───────────────────────────────────────────────
PROMPTLABS_DEFAULT_MODEL=claude-sonnet-4-6
PROMPTLABS_DB_URL=sqlite+aiosqlite:///./data/promptlabs.db
PROMPTLABS_CACHE_DIR=./data/cache
PROMPTLABS_LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
