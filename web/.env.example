# PromptLabs web — environment variables
#
# Copy to .env.local before running `pnpm dev` or `pnpm build`.
# Variables prefixed with NEXT_PUBLIC_ are baked in at build/dev-start time,
# so restart the dev server after changing them.

# The PromptLabs API URL. Default if unset: http://localhost:8000
# Override when running the API on a different port (e.g. 8001 in development).
NEXT_PUBLIC_API_URL=http://localhost:8001
